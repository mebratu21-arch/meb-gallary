# ─────────────────────────────────────────────────────────────────────────────
# Meb Gallery — Environment Variables
# Copy this file to .env and fill in the values before running the project.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL 16 with pgvector. Docker: postgresql://postgres:postgres@localhost:5432/meb_gallery
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meb_gallery

# ── Redis ──────────────────────────────────────────────────────────────────
# Docker default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-random-32-char-secret-minimum
# Access token lifetime (e.g. 15m, 1h)
JWT_EXPIRES_IN=15m
# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRES_IN_DAYS=14

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ── Google OAuth ───────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ── Cloudinary (image storage) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── OpenAI (AI Vision, DALL-E 3 Image Generation, Smart Search) ─────────────
# Get your API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Seed data ──────────────────────────────────────────────────────────────
# Used by prisma/seed.ts — set before running `pnpm prisma db seed`
SEED_ADMIN_EMAIL=admin@mebgallery.local
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_DEMO_EMAIL=demo@mebgallery.local
SEED_DEMO_PASSWORD=DemoPassword123!
